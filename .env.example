# --- AI writer ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# --- Telegram approval bot (create with @BotFather; get your chat id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=123456:ABC...
OWNER_CHAT_ID=123456789

# --- Daily mix: how many videos of each kind per day ---
NEWS_VIDEOS=2            # "news explainers" from news sources
EXPLAINER_VIDEOS=3       # facts / science / history / mysteries / tech / geopolitics / mindset (like V R Facts, Think Deep)
NEWS_MINUTES=4
EXPLAINER_MINUTES=8

# --- AI images ---
# gemini | openai | none (none = stock photos from Pexels, then plain background)
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_STYLE=cinematic digital illustration, rich colours, dramatic lighting, highly detailed, 16:9 widescreen
SHOW_AI_LABEL=true       # small "AI illustration" tag on every frame
PEXELS_API_KEY=          # fallback if image generation fails

# --- Telugu voice ---
TTS_PROVIDER=edge        # edge = free for testing, azure = production
TTS_VOICE=te-IN-ShrutiNeural   # or te-IN-MohanNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# --- Look ---
FONT_PATH=./NotoSansTelugu-Bold.ttf
CHANNEL_NAME=Your Channel Name
MUSIC_PATH=              # optional royalty-free background music file (mp3), mixed very quietly

# --- Schedule / upload ---
RUN_HOUR=7
RUN_MINUTE=0
TIMEZONE=Asia/Kolkata
UPLOAD_PRIVACY=public    # new API projects are forced to private until Google audits them
